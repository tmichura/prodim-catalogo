---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Prodim · Catálogo de productos químicos",
  description = "Catálogo de productos de limpieza e industriales Prodim. Consultá precios por escala de volumen y armá tu pedido directo por WhatsApp.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
