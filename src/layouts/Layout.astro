---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Prodim · Productos Químicos",
  description = "Prodim: fabricación y distribución de productos químicos de limpieza industrial y doméstica. Más de 600 productos, con precios según volumen de compra.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/og-image.jpg", Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Open Graph: la tarjeta que se ve al compartir el link por WhatsApp/redes -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Prodim" />

    <!-- Twitter/X usa sus propias etiquetas, aunque tomen los mismos valores -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="min-h-screen">
    <slot />

    <script>
      // El header cambia de alto según el breakpoint (el logo mide distinto
      // en mobile/desktop). El NavBar necesita saber esa altura real para
      // pegarse justo debajo, si no queda un salto/superposición al scrollear.
      function actualizarAlturaHeader(): void {
        const header = document.querySelector("header");
        if (!header) return;
        document.documentElement.style.setProperty("--header-height", `${header.offsetHeight}px`);

        // Header + NavBar juntos: lo usa la barra lateral flotante del catálogo
        // para saber a qué altura "pegarse" sin quedar tapada por ninguno de los dos.
        const nav = document.querySelector("nav");
        const topbarsHeight = header.offsetHeight + (nav?.offsetHeight || 0);
        document.documentElement.style.setProperty("--topbars-height", `${topbarsHeight + 16}px`);
      }

      actualizarAlturaHeader();
      window.addEventListener("resize", actualizarAlturaHeader);

      // Si las fuentes (Garet, Comfortaa) tardan en cargar, el header puede
      // cambiar de alto después de la primera medición, dejando un hueco/línea
      // entre el header y el NavBar. Recalculamos cuando terminan de cargar.
      document.fonts?.ready.then(actualizarAlturaHeader);
    </script>
  </body>
</html>
