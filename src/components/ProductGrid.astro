---
import ProductCard from "./ProductCard.astro";
import type { Producto, SuperCategoria } from "../lib/products";

interface Props {
  productos: Producto[];
  superCategorias: SuperCategoria[];
}

const { productos, superCategorias } = Astro.props;

const WHATSAPP_NUMBER = import.meta.env.PUBLIC_WHATSAPP_NUMBER || "";
const mensajeAyuda = encodeURIComponent("Hola! Necesito ayuda para elegir productos de limpieza.");
const whatsappAyuda = WHATSAPP_NUMBER ? `https://wa.me/${WHATSAPP_NUMBER}?text=${mensajeAyuda}` : "#";
---

<section class="mx-auto max-w-7xl px-4 py-6">
  <div class="flex flex-col gap-6 lg:flex-row lg:items-start">
    <!-- Barra lateral de categorías: flotante (sticky) en desktop, arriba de la grilla en mobile -->
    <aside class="lg:sticky lg:top-[var(--topbars-height,140px)] lg:w-64 lg:shrink-0">
      <div class="rounded-lg border border-ink-100 bg-white p-4 shadow-card lg:max-h-[calc(100vh-var(--topbars-height,140px)-2rem)] lg:overflow-y-auto">
        <h2 class="mb-3 text-xs font-bold uppercase tracking-wide text-ink-400">Categorías</h2>

        <button
          type="button"
          data-categoria="todas"
          class="category-chip active block w-full rounded-md px-3 py-2 text-left text-sm font-semibold text-ink-700 transition-colors hover:bg-ink-50"
        >
          TODOS
        </button>

        <div class="mt-1 divide-y divide-ink-100">
          {superCategorias.map((sc) => (
            <div>
              <button
                type="button"
                class="super-categoria-toggle flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-xs font-bold uppercase tracking-wide text-[#202E76] transition-colors hover:bg-ink-50"
                aria-expanded="false"
              >
                {sc.nombre}
                <svg class="super-categoria-arrow h-3.5 w-3.5 shrink-0 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
              <div class="super-categoria-panel hidden pb-1 pl-2">
                {sc.categorias.map((cat) => (
                  <button
                    type="button"
                    data-categoria={cat.slug}
                    class="category-chip block w-full rounded-md px-3 py-2 text-left text-sm text-ink-700 transition-colors hover:bg-ink-50"
                  >
                    {cat.nombre}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Caja de ayuda / contacto directo -->
      <div class="mt-4 rounded-lg border border-ink-100 bg-ink-50/60 p-4">
        <p class="mb-1 text-sm font-semibold text-ink-900">¿Necesitás ayuda?</p>
        <p class="mb-3 text-xs text-ink-500">
          Escribinos y te ayudamos a elegir los productos que necesitás.
        </p>
        <a
          href={whatsappAyuda}
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring block rounded-md bg-[#0B9DCF] px-3 py-2 text-center text-xs font-semibold uppercase text-white transition-colors hover:bg-[#0989b8]"
        >
          Consultar por WhatsApp
        </a>
      </div>
    </aside>

    <!-- Resultados -->
    <div class="min-w-0 flex-1">
      <h1 id="categoria-actual" class="mb-1 font-display text-xl font-bold text-[#202E76] sm:text-2xl">Tienda</h1>

      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs text-ink-400">
          Mostrando <span id="results-count" class="font-mono font-semibold text-ink-700">{productos.length}</span>
          de <span class="font-mono">{productos.length}</span> productos
        </p>

        <label class="flex items-center gap-2 text-xs text-ink-500">
          Ordenar por
          <select
            id="sort-select"
            class="focus-ring rounded-md border border-ink-200 bg-white px-2 py-1.5 text-xs font-medium text-ink-700"
          >
            <option value="relevancia">Relevancia</option>
            <option value="precio-asc">Precio: menor a mayor</option>
            <option value="precio-desc">Precio: mayor a menor</option>
            <option value="nombre-asc">Nombre: A-Z</option>
            <option value="nombre-desc">Nombre: Z-A</option>
          </select>
        </label>
      </div>

      <div id="product-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {productos.map((producto) => (
          <ProductCard producto={producto} />
        ))}
      </div>

      <div id="no-results" class="hidden py-16 text-center text-ink-400">
        <p class="font-display text-lg font-semibold text-ink-600">No encontramos productos</p>
        <p class="mt-1 text-sm">Probá con otra categoría o con otro término de búsqueda.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .category-chip.active {
    @apply bg-ink-100 text-ink-900;
  }
</style>
