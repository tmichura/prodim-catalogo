---
import ProductCard from "./ProductCard.astro";
import { slugify, type Producto, type SuperCategoria } from "../lib/products";

interface Props {
  productos: Producto[];
  superCategorias: SuperCategoria[];
}

const { productos, superCategorias } = Astro.props;

const grupos = superCategorias.map((sc) => ({
  ...sc,
  slug: slugify(sc.nombre),
  categoriasCsv: sc.categorias.map((c) => c.slug).join(","),
}));

const WHATSAPP_NUMBER = import.meta.env.PUBLIC_WHATSAPP_NUMBER || "";
const mensajeAyuda = encodeURIComponent("Hola! Necesito ayuda para elegir productos de limpieza.");
const whatsappAyuda = WHATSAPP_NUMBER ? `https://wa.me/${WHATSAPP_NUMBER}?text=${mensajeAyuda}` : "#";
---

<section class="mx-auto max-w-7xl px-4 py-4 sm:py-6">
  <div class="flex flex-col gap-6 lg:flex-row lg:items-start">
    <!-- Barra lateral de categorías: solo desktop (en mobile van los chips de arriba) -->
    <aside class="hidden lg:sticky lg:top-[var(--topbars-height,140px)] lg:block lg:w-64 lg:shrink-0">
      <div class="rounded-lg border border-ink-100 bg-white p-4 shadow-card lg:max-h-[calc(100vh-var(--topbars-height,140px)-2rem)] lg:overflow-y-auto">
        <h2 class="mb-3 text-xs font-bold uppercase tracking-wide text-ink-500">Categorías</h2>

        <button
          type="button"
          data-categoria="todas"
          class="category-chip active block w-full rounded-md px-3 py-2 text-left text-sm font-semibold text-ink-700 transition-colors hover:bg-ink-50"
        >
          TODOS
        </button>

        <div class="mt-1 divide-y divide-ink-100">
          {grupos.map((g) => (
            <div>
              <button
                type="button"
                class="super-categoria-toggle flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-xs font-bold uppercase tracking-wide text-ink-700 transition-colors hover:bg-ink-50"
                aria-expanded="false"
              >
                {g.nombre}
                <svg class="super-categoria-arrow h-3.5 w-3.5 shrink-0 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
              <div class="super-categoria-panel hidden pb-1 pl-2">
                <button
                  type="button"
                  data-categorias={g.categoriasCsv}
                  data-grupo={g.slug}
                  data-titulo={g.nombre}
                  class="category-chip block w-full rounded-md px-3 py-2 text-left text-sm font-semibold text-ink-700 transition-colors hover:bg-ink-50"
                >
                  Ver todo
                </button>
                {g.categorias.map((cat) => (
                  <button
                    type="button"
                    data-categoria={cat.slug}
                    data-grupo={g.slug}
                    class="category-chip block w-full rounded-md px-3 py-2 text-left text-sm text-ink-700 transition-colors hover:bg-ink-50"
                  >
                    {cat.nombre}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Caja de ayuda / contacto directo -->
      <div class="mt-4 rounded-lg border border-ink-100 bg-white p-4 shadow-card">
        <p class="mb-1 text-sm font-semibold text-ink-900">¿Necesitás ayuda?</p>
        <p class="mb-3 text-xs text-ink-600">
          Escribinos y te ayudamos a elegir los productos que necesitás.
        </p>
        <a
          href={whatsappAyuda}
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring block rounded-md bg-ink-700 px-3 py-2 text-center text-xs font-semibold uppercase text-white transition-colors hover:bg-ink-800"
        >
          Consultar por WhatsApp
        </a>
      </div>
    </aside>

    <!-- Resultados -->
    <div class="min-w-0 flex-1">
      <!-- Chips de categorías: solo mobile/tablet. Primera fila = grupos;
           al elegir uno aparece una segunda fila con sus categorías. -->
      <div id="chips-mobile" class="lg:hidden">
        <div class="chips-scroll -mx-4 flex gap-2 overflow-x-auto px-4 pb-2">
          <button type="button" data-categoria="todas" class="category-chip chip focus-ring active">Todos</button>
          {grupos.map((g) => (
            <button
              type="button"
              data-categorias={g.categoriasCsv}
              data-grupo={g.slug}
              data-titulo={g.nombre}
              class="category-chip chip focus-ring"
            >
              {g.nombre.charAt(0) + g.nombre.slice(1).toLowerCase()}
            </button>
          ))}
        </div>
        {grupos.map((g) => (
          <div class="chips-scroll chips-subgrupo -mx-4 hidden gap-2 overflow-x-auto px-4 pb-2" data-grupo-panel={g.slug}>
            {g.categorias.map((cat) => (
              <button
                type="button"
                data-categoria={cat.slug}
                data-grupo={g.slug}
                class="category-chip chip chip-sub focus-ring"
              >
                {cat.nombre.charAt(0) + cat.nombre.slice(1).toLowerCase()}
              </button>
            ))}
          </div>
        ))}
      </div>

      <div id="resultados-inicio" class="mt-2 lg:mt-0">
        <h1 id="categoria-actual" class="font-display text-xl font-bold text-ink-700 sm:text-2xl">Tienda</h1>

        <div class="mb-4 mt-1 flex flex-wrap items-center justify-between gap-2">
          <p class="text-xs text-ink-600">
            Mostrando <span id="results-count" class="font-mono font-semibold text-ink-800">{productos.length}</span>
            de <span id="results-total" class="font-mono font-semibold text-ink-800">{productos.length}</span> productos
          </p>

          <label class="flex items-center gap-2 text-xs text-ink-600">
            Ordenar por
            <select
              id="sort-select"
              class="focus-ring rounded-md border border-ink-200 bg-white px-2 py-1.5 text-xs font-medium text-ink-700"
            >
              <option value="relevancia">Relevancia</option>
              <option value="precio-asc">Precio: menor a mayor</option>
              <option value="precio-desc">Precio: mayor a menor</option>
              <option value="nombre-asc">Nombre: A-Z</option>
              <option value="nombre-desc">Nombre: Z-A</option>
            </select>
          </label>
        </div>
      </div>

      <div id="product-grid" class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 xl:grid-cols-3">
        {productos.map((producto) => (
          <ProductCard producto={producto} />
        ))}
      </div>

      <div id="load-more-wrap" class="mt-6 hidden text-center">
        <button
          type="button"
          id="load-more"
          class="focus-ring rounded-md border border-ink-200 bg-white px-6 py-3 text-sm font-semibold text-ink-800 shadow-card transition-colors hover:bg-ink-50"
        >
          Ver más productos
        </button>
      </div>

      <div id="no-results" class="hidden py-16 text-center text-ink-600">
        <p class="font-display text-lg font-semibold text-ink-700">No encontramos productos</p>
        <p class="mt-1 text-sm">Probá con otra categoría o con otro término de búsqueda.</p>
        <a
          href={whatsappAyuda}
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring mt-4 inline-block rounded-md bg-ink-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-ink-800"
        >
          Consultanos por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .category-chip.active:not(.chip) {
    @apply bg-ink-100 text-ink-900;
  }
  .chip {
    @apply shrink-0 whitespace-nowrap rounded-full border border-ink-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-ink-700 transition-colors;
  }
  .chip.active {
    @apply border-ink-700 bg-ink-700 text-white;
  }
  .chip-sub {
    @apply py-1 font-medium;
  }
  .chips-subgrupo.abierto {
    @apply flex;
  }
  .chips-scroll {
    scrollbar-width: none;
  }
  .chips-scroll::-webkit-scrollbar {
    display: none;
  }
</style>
