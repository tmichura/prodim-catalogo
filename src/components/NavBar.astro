---
interface Props {
  activo?: "inicio" | "catalogo" | "quienes-somos" | "carrito";
}

const { activo } = Astro.props;

const links = [
  { id: "inicio", label: "Inicio", href: "/" },
  { id: "catalogo", label: "Catálogo", href: "/productos" },
  { id: "quienes-somos", label: "Quiénes somos", href: "/quienes-somos" },
  { id: "carrito", label: "Carrito", href: "/carrito" },
];
---

<nav class="sticky top-[64px] z-30 border-b border-ink-100 bg-white">
  <div class="mx-auto grid max-w-7xl grid-cols-4">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          "focus-ring flex items-center justify-center border-r border-ink-100 px-2 py-3 text-center text-xs font-semibold uppercase tracking-wide text-ink-600 transition-colors last:border-r-0 hover:bg-ink-50 sm:text-sm",
          { "bg-ink-800 text-white hover:bg-ink-800": activo === link.id },
        ]}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>
