---
---

<!-- Fondo oscuro -->
<div
  id="cart-backdrop"
  class="fixed inset-0 z-40 hidden bg-ink-950/50 backdrop-blur-sm"
  aria-hidden="true"
></div>

<!-- Panel lateral del carrito -->
<aside
  id="cart-drawer"
  class="fixed inset-y-0 right-0 z-50 flex w-full max-w-md translate-x-full flex-col bg-white shadow-drawer transition-transform duration-300 ease-out"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-title"
>
  <div class="flex items-center justify-between border-b border-ink-100 px-5 py-4">
    <h2 id="cart-title" class="font-display text-lg font-semibold text-ink-700">Tu pedido</h2>
    <button
      type="button"
      id="close-cart"
      class="focus-ring rounded-md p-1.5 text-ink-500 hover:bg-ink-50 hover:text-ink-900"
      aria-label="Cerrar carrito"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Lista de ítems -->
  <div id="cart-items" class="flex-1 space-y-3 overflow-y-auto px-5 py-4">
    <!-- Se completa dinámicamente desde localStorage vía cart.ts -->
  </div>

  <!-- Estado vacío -->
  <div id="cart-empty" class="hidden flex-1 flex items-center justify-center px-5 text-center text-ink-400">
    <p class="text-sm">Carrito vacío</p>
  </div>

  <!-- Footer: datos de contacto + total + WhatsApp -->
  <div class="border-t border-ink-100 bg-ink-50/60 px-5 py-4">
    <div class="mb-3">
      <label for="cliente-nombre" class="mb-1 block text-xs font-medium text-ink-600">
        Nombre / Empresa (opcional)
      </label>
      <input
        id="cliente-nombre"
        type="text"
        placeholder="Ej: Distribuidora Sur SRL"
        class="focus-ring w-full rounded-md border border-ink-200 bg-white px-3 py-2 text-sm text-ink-900 placeholder:text-ink-400"
      />
    </div>

    <div class="mb-3 flex items-center justify-between font-display">
      <span class="text-sm font-medium text-ink-600">Total estimado</span>
      <span id="cart-total" class="font-mono text-lg font-bold text-ink-900">$0</span>
    </div>
    <p class="mb-3 text-[11px] leading-snug text-ink-400">
      El total es orientativo. Los precios finales, disponibilidad y forma de pago se confirman por WhatsApp.
    </p>

    <button
      type="button"
      id="checkout-whatsapp"
      disabled
      class="focus-ring flex w-full items-center justify-center gap-2 rounded-md bg-batch-500 px-4 py-3 text-sm font-bold text-ink-900 transition-colors hover:bg-batch-400 disabled:cursor-not-allowed disabled:opacity-50"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.94 11.94 0 0 0 12.04 0C5.5 0 .2 5.3.2 11.85c0 2.09.55 4.13 1.6 5.93L0 24l6.4-1.68a11.86 11.86 0 0 0 5.64 1.44h.01c6.54 0 11.85-5.3 11.85-11.85 0-3.17-1.23-6.15-3.38-8.43ZM12.05 21.6a9.7 9.7 0 0 1-4.95-1.36l-.35-.21-3.7.97.99-3.6-.23-.37a9.75 9.75 0 1 1 8.24 4.57Zm5.34-7.3c-.29-.15-1.72-.85-1.99-.94-.27-.1-.46-.15-.66.14-.2.29-.76.94-.93 1.13-.17.2-.34.22-.63.07-.29-.15-1.23-.45-2.34-1.44-.87-.77-1.45-1.72-1.62-2.01-.17-.29-.02-.45.13-.6.13-.13.29-.34.44-.51.15-.17.2-.29.29-.48.1-.2.05-.37-.02-.51-.07-.15-.66-1.59-.9-2.17-.24-.57-.48-.5-.66-.5h-.56c-.2 0-.51.07-.78.37-.27.29-1.02 1-1.02 2.44s1.05 2.83 1.19 3.03c.15.2 2.06 3.15 5 4.42.7.3 1.24.48 1.67.62.7.22 1.34.19 1.84.12.56-.08 1.72-.7 1.96-1.38.24-.68.24-1.26.17-1.38-.07-.12-.26-.2-.55-.34Z"/></svg>
      Finalizar pedido por WhatsApp
    </button>

    <button
      type="button"
      id="clear-cart"
      class="focus-ring mt-2 w-full rounded-md py-2 text-xs font-medium text-ink-400 hover:text-red-600"
    >
      Vaciar carrito
    </button>
  </div>
</aside>

<!-- Plantilla de un ítem del carrito, clonada por cart.ts -->
<template id="cart-item-template">
  <div class="cart-item flex gap-3 rounded-md border border-ink-100 p-3" data-item-key="">
    <div class="min-w-0 flex-1">
      <p class="stencil-tag">COD. <span class="item-codigo"></span></p>
      <p class="truncate text-sm font-semibold text-ink-900 item-nombre"></p>
      <p class="font-mono text-xs text-ink-500 item-escala"></p>

      <div class="mt-2 flex items-center gap-2">
        <button type="button" class="qty-decrease focus-ring h-8 w-8 rounded border border-ink-200 text-base font-semibold leading-none text-ink-600 hover:bg-ink-50 md:h-6 md:w-6 md:text-sm">−</button>
        <span class="item-cantidad w-6 text-center font-mono text-sm"></span>
        <button type="button" class="qty-increase focus-ring h-8 w-8 rounded border border-ink-200 text-base font-semibold leading-none text-ink-600 hover:bg-ink-50 md:h-6 md:w-6 md:text-sm">+</button>
      </div>
    </div>
    <div class="flex shrink-0 flex-col items-end justify-between gap-2">
      <div class="font-mono text-sm font-semibold text-ink-900 item-subtotal"></div>
      <button type="button" class="item-remove focus-ring text-xs font-medium text-ink-400 hover:text-red-600">Quitar</button>
    </div>
  </div>
</template>

<!-- Leyenda breve al agregar un producto en mobile (en vez de abrir el carrito) -->
<div
  id="cart-toast"
  class="pointer-events-none fixed left-1/2 top-4 z-[60] w-[calc(100%-2rem)] max-w-sm -translate-x-1/2 -translate-y-4 rounded-md bg-ink-800 px-4 py-3 text-center text-sm font-medium text-white opacity-0 shadow-drawer transition-all duration-200 ease-out"
  role="status"
  aria-live="polite"
></div>
