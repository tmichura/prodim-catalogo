---
import { formatARS } from "../lib/pricing";
import type { Producto } from "../lib/products";
import { existsSync } from "fs";
import { join } from "path";

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const groupName = `escala-${producto.codigo}`;

// Verificar si existe imagen para este producto
const imagePath = join(process.cwd(), "public", "images", "productos", `${producto.codigo}.jpg`);
const tieneImagen = existsSync(imagePath);

// Payload que la card expone para que el JS del carrito lo lea sin
// tener que volver a parsear nada ni pegarle al DOM de más.
const payload = JSON.stringify({
  codigo: producto.codigo,
  nombre: producto.nombre,
  categoria: producto.categoria,
  escalas: producto.escalas,
});
---

<article
  class="product-card group flex flex-col rounded-lg border border-ink-100 bg-white font-comfortaa shadow-card transition-shadow hover:shadow-lg"
  data-categoria={producto.categoriaSlug}
  data-nombre={producto.nombre.toLowerCase()}
  data-codigo={producto.codigo}
  data-precio={producto.escalas[0]?.precioUnitario ?? 0}
  data-product={payload}
>
  <!-- Encabezado: código estilo etiqueta de bidón -->
  <div class="flex items-center justify-between border-b border-dashed border-ink-100 px-4 py-2.5">
    <span class="stencil-tag">COD. {producto.codigo}</span>
    <span class="stencil-tag truncate pl-2 text-ink-400">{producto.categoria.replace(/^\d+\*\s*/, "")}</span>
  </div>

  {tieneImagen && (
    <div class="aspect-square w-full overflow-hidden bg-white p-3">
      <img
        src={`/images/productos/${producto.codigo}.jpg`}
        alt={producto.nombre}
        class="h-full w-full object-contain"
      />
    </div>
  )}

  <div class="flex flex-1 flex-col gap-3 p-4">
    <h3 class="text-[15px] font-semibold leading-snug text-ink-900">
      {producto.nombre}
    </h3>

    <!-- Ficha de precios por escala, tipo hoja técnica. Tocar una escala suma
         su cantidad al pedido; la escala activa se resalta sola según la
         cantidad cargada (ver src/scripts/cart.ts). -->
    <div class="escala-list mt-1 divide-y divide-ink-100 rounded-md border border-ink-100 bg-ink-50/50" data-escalas>
      {producto.escalas.map((escala, i) => (
        <button
          type="button"
          class="escala-row flex w-full cursor-pointer items-center justify-between gap-3 px-3 py-2 text-left transition-colors hover:bg-ink-100"
          data-escala-index={i}
          data-cantidad-minima={escala.cantidadMinima}
          aria-label={`Sumar ${escala.cantidadMinima} ${escala.unidad} al pedido`}
        >
          <span class="font-mono text-xs font-semibold tracking-tight">
            {escala.etiqueta}
          </span>
          <span class="font-mono text-sm font-semibold">
            {formatARS(escala.precioUnitario)}
            <span class="text-[11px] font-normal opacity-70">/{escala.unidad}</span>
          </span>
        </button>
      ))}
    </div>

    <div class="mt-auto flex items-center gap-2 pt-2">
      <label class="sr-only" for={`qty-${producto.codigo}`}>Cantidad</label>
      <input
        id={`qty-${producto.codigo}`}
        type="number"
        min="1"
        step="1"
        placeholder="-"
        class="qty-input focus-ring w-20 rounded-md border border-ink-200 bg-white px-2 py-2 text-center font-mono text-sm text-ink-900 placeholder-shown:text-ink-300 md:w-16"
      />
      <button
        type="button"
        data-add-to-cart
        class="focus-ring flex-1 rounded-md bg-ink-800 px-3 py-2 text-sm font-semibold text-white transition-colors hover:bg-ink-700 active:bg-ink-900"
      >
        Agregar al pedido
      </button>
    </div>
  </div>
</article>
