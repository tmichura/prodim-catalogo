---
import type { Producto } from "../lib/products";
import { resolverImagenProducto } from "../lib/images";
import { terminosImitacion } from "../lib/imitaciones";
import CompraProducto from "./CompraProducto.astro";

interface Props {
  producto: Producto;
  /** "grilla": horizontal y compacta en mobile, vertical desde sm.
   *  "vertical": siempre vertical (carruseles, relacionados). */
  variante?: "grilla" | "vertical";
}

const { producto, variante = "grilla" } = Astro.props;
const vertical = variante === "vertical";

const imagenProducto = resolverImagenProducto(producto.codigo);
const categoriaNombre = producto.categoria.replace(/^\d+\*\s*/, "");
const terminosExtra = terminosImitacion(producto.nombre, producto.categoria).join(" ");
const urlProducto = `/productos/${producto.codigo}/`;

// Payload que la card expone para que el JS del carrito lo lea sin
// tener que volver a parsear nada ni pegarle al DOM de más.
const payload = JSON.stringify({
  codigo: producto.codigo,
  nombre: producto.nombre,
  categoria: producto.categoria,
  escalas: producto.escalas,
});

// En la grilla, debajo de sm la card es horizontal (foto chica a la
// izquierda): así entran varios productos por pantalla en el celular.
const c = vertical
  ? {
      encabezado: "flex",
      cuerpo: "flex flex-col",
      foto: "block aspect-[4/3] w-full p-3",
      textos: "px-4 pt-1",
      codigoMobile: "hidden",
      compra: "px-4 pb-4",
    }
  : {
      encabezado: "hidden sm:flex",
      cuerpo: "flex gap-3 p-3 pb-0 sm:flex-col sm:gap-0 sm:p-0",
      foto: "block h-24 w-24 shrink-0 sm:aspect-[4/3] sm:h-auto sm:w-full sm:p-3",
      textos: "min-w-0 sm:px-4 sm:pt-1",
      codigoMobile: "sm:hidden",
      compra: "px-3 pb-3 sm:px-4 sm:pb-4",
    };
---

<article
  class="product-card group flex flex-col rounded-lg border border-ink-100 bg-white font-comfortaa shadow-card transition-shadow hover:shadow-lg"
  data-categoria={producto.categoriaSlug}
  data-nombre={producto.nombre.toLowerCase()}
  data-categoria-nombre={categoriaNombre.toLowerCase()}
  data-terminos-extra={terminosExtra}
  data-codigo={producto.codigo}
  data-precio={producto.escalas[0]?.precioUnitario ?? 0}
  data-product={payload}
>
  <!-- Encabezado: código estilo etiqueta de bidón -->
  <div class:list={[c.encabezado, "items-center justify-between border-b border-dashed border-ink-100 px-4 py-2"]}>
    <span class="stencil-tag shrink-0 whitespace-nowrap">COD. {producto.codigo}</span>
    <span class="stencil-tag truncate pl-2">{categoriaNombre}</span>
  </div>

  <div class={c.cuerpo}>
    <a href={urlProducto} class:list={[c.foto, "focus-ring relative overflow-hidden rounded-md bg-white"]} tabindex="-1" aria-hidden="true">
      {imagenProducto ? (
        <img
          src={imagenProducto}
          alt=""
          width="400"
          height="400"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full rounded-2xl object-contain p-[inherit]"
        />
      ) : (
        <img
          src="/images/sin-foto.webp"
          alt=""
          width="240"
          height="222"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-contain p-[18%] opacity-25"
        />
      )}
    </a>

    <div class={c.textos}>
      <p class:list={[c.codigoMobile, "stencil-tag"]}>COD. {producto.codigo}</p>
      <h3 class="text-sm font-semibold leading-snug text-ink-900 sm:text-[15px]">
        <a href={urlProducto} class="focus-ring rounded hover:underline">{producto.nombre}</a>
      </h3>
      {producto.dilucion && (
        <p class="stencil-tag mt-1 text-batch-700">DILUCIÓN {producto.dilucion}</p>
      )}
    </div>
  </div>

  <div class:list={[c.compra, "flex flex-1 flex-col gap-2 pt-3"]}>
    <CompraProducto producto={producto} />
  </div>
</article>
