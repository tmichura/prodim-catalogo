---
const WHATSAPP_NUMBER = import.meta.env.PUBLIC_WHATSAPP_NUMBER || "";
const whatsappUrl = WHATSAPP_NUMBER ? `https://wa.me/${WHATSAPP_NUMBER}` : "#";

const redes = [
  {
    nombre: "WhatsApp",
    href: whatsappUrl,
    icono: "whatsapp",
  },
  {
    nombre: "Instagram",
    href: "https://instagram.com/prodim.ar",
    icono: "instagram",
  },
  {
    nombre: "TikTok",
    href: "https://tiktok.com/@prodim.ar",
    icono: "tiktok",
  },
  {
    nombre: "Facebook",
    href: "https://www.facebook.com/share/18tAjqWaJi/",
    icono: "facebook",
  },
];
---

<footer class="border-t border-ink-100 py-8 text-center text-xs text-ink-400">
  <div class="mb-5 flex items-center justify-center gap-3">
    {redes.map((red) => (
      <a
        href={red.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={red.nombre}
        class="focus-ring flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-600 transition-colors hover:border-ink-800 hover:bg-ink-800 hover:text-white"
      >
        {red.icono === "whatsapp" && (
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
            <path d="M12.001 2c-5.514 0-9.999 4.486-9.999 10 0 1.762.464 3.489 1.346 5.006L2 22l5.144-1.34a9.965 9.965 0 0 0 4.857 1.24h.004c5.514 0 9.998-4.486 9.998-10 0-2.671-1.04-5.182-2.929-7.071A9.937 9.937 0 0 0 12.001 2zm0 18.153h-.003a8.28 8.28 0 0 1-4.22-1.155l-.303-.18-3.053.795.815-2.977-.197-.306a8.257 8.257 0 0 1-1.267-4.416c0-4.567 3.716-8.283 8.23-8.283a8.223 8.223 0 0 1 5.82 2.413 8.223 8.223 0 0 1 2.408 5.825c0 4.567-3.716 8.284-8.23 8.284z"></path>
          </svg>
        )}
        {red.icono === "instagram" && (
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        )}
        {red.icono === "tiktok" && (
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M16.6 5.82s.51.5 0 0A4.278 4.278 0 0 1 15.54 3h-3.09v12.4a2.592 2.592 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z"></path>
          </svg>
        )}
        {red.icono === "facebook" && (
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"></path>
          </svg>
        )}
      </a>
    ))}
  </div>

  Prodim © {new Date().getFullYear()} — Tienda informativa. Precios sujetos a confirmación por WhatsApp.
</footer>
