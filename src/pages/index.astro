---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import NavBar from "../components/NavBar.astro";
import Carousel from "../components/Carousel.astro";
import FeaturedCarousel from "../components/FeaturedCarousel.astro";
import CartDrawer from "../components/CartDrawer.astro";
import Footer from "../components/Footer.astro";
import { getProductos } from "../lib/products";
import { existsSync } from "fs";
import { join } from "path";

function tieneImagen(codigo: number): boolean {
  return existsSync(join(process.cwd(), "public", "images", "productos", `${codigo}.jpg`));
}

const WHATSAPP_NUMBER = import.meta.env.PUBLIC_WHATSAPP_NUMBER || "";
const mensajeRevendedores = encodeURIComponent(
  "Hola Prodim! Quiero información para ser revendedor/distribuidor de sus productos."
);
const whatsappRevendedores = WHATSAPP_NUMBER
  ? `https://wa.me/${WHATSAPP_NUMBER}?text=${mensajeRevendedores}`
  : "#";

// Productos destacados: elegidos al azar entre las categorías posteriores
// a "14* COSMETICA AUTOMOTOR" (orden > 14), se recalculan en cada build.
function ordenDeCategoria(categoria: string): number {
  const match = categoria.match(/^(\d+)\*/);
  return match ? parseInt(match[1], 10) : 999;
}

const productos = getProductos();
const productosDestacados = productos
  .filter((p) => ordenDeCategoria(p.categoria) > 14 && tieneImagen(p.codigo))
  .sort(() => Math.random() - 0.5)
  .slice(0, 10);
---

<Layout>
  <Header />
  <NavBar activo="inicio" />

  <main>
    <Carousel />

    <!-- Sección institucional / bienvenida -->
    <section class="mx-auto max-w-4xl px-4 py-14 text-center">
      <span class="stencil-tag">PRODIM · PRODUCTOS QUÍMICOS</span>
      <h1 class="mt-3 font-display text-2xl font-bold text-ink-900 sm:text-3xl">
        Productos de limpieza al por mayor, con el precio que se ajusta a lo que necesitás
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-sm text-ink-500 sm:text-base">
        Más de 600 productos con escalas de precio automáticas según la cantidad que pidas.
        Armá tu pedido y coordinalo directo por WhatsApp.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/productos"
          class="focus-ring w-full rounded-md bg-ink-800 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-ink-700 sm:w-auto"
        >
          Ver catálogo completo
        </a>
        <a
          href={whatsappRevendedores}
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring w-full rounded-md border border-ink-200 px-6 py-3 text-sm font-semibold text-ink-800 transition-colors hover:bg-ink-50 sm:w-auto"
        >
          Información para revendedores
        </a>
      </div>
    </section>

    <FeaturedCarousel productos={productosDestacados} titulo="Productos destacados" />
  </main>

  <CartDrawer />

  <Footer />

  <script src="../scripts/header-dropdown.ts"></script>
  <script src="../scripts/mobile-search.ts"></script>
  <script src="../scripts/cart.ts"></script>
</Layout>
