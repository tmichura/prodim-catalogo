---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import NavBar from "../components/NavBar.astro";
import CartDrawer from "../components/CartDrawer.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Prodim · Página no encontrada" description="La página que buscás no existe o cambió de dirección.">
  <Header />
  <NavBar />

  <main>
    <section class="mx-auto max-w-lg px-4 py-20 text-center">
      <span class="stencil-tag">PRODIM · PRODUCTOS QUÍMICOS</span>
      <p class="mt-3 font-display text-6xl font-bold text-ink-700 sm:text-7xl">404</p>
      <h1 class="mt-3 font-display text-xl font-bold text-ink-900 sm:text-2xl">
        Esta página no existe
      </h1>
      <p class="mx-auto mt-4 max-w-md text-sm text-ink-500 sm:text-base">
        Puede que el link esté mal escrito o que la página haya cambiado de dirección.
        Probá desde acá:
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/"
          class="focus-ring w-full rounded-md bg-ink-800 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-ink-700 sm:w-auto"
        >
          Volver al inicio
        </a>
        <a
          href="/productos"
          class="focus-ring w-full rounded-md border border-ink-200 px-6 py-3 text-sm font-semibold text-ink-800 transition-colors hover:bg-ink-50 sm:w-auto"
        >
          Ver la tienda
        </a>
      </div>
    </section>
  </main>

  <CartDrawer />

  <Footer />

  <script src="../scripts/header-dropdown.ts"></script>
  <script src="../scripts/mobile-search.ts"></script>
  <script src="../scripts/cart.ts"></script>
</Layout>
