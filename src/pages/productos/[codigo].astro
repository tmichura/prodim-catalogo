---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import NavBar from "../../components/NavBar.astro";
import CartDrawer from "../../components/CartDrawer.astro";
import Footer from "../../components/Footer.astro";
import CompraProducto from "../../components/CompraProducto.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getProductos, type Producto } from "../../lib/products";
import { resolverImagenProducto } from "../../lib/images";
import { formatARS } from "../../lib/pricing";

export function getStaticPaths() {
  const productos = getProductos();
  return productos.map((producto) => ({
    params: { codigo: String(producto.codigo) },
    props: { producto, productos },
  }));
}

interface Props {
  producto: Producto;
  productos: Producto[];
}

const { producto, productos } = Astro.props;

const imagen = resolverImagenProducto(producto.codigo);
const categoriaNombre = producto.categoria.replace(/^\d+\*\s*/, "");
const precioDesde = producto.escalas.length
  ? Math.min(...producto.escalas.map((e) => e.precioUnitario))
  : 0;
const unidad = producto.escalas[0]?.unidad ?? "u";

// Relacionados: misma categoría, primero los que tienen foto
const relacionados = productos
  .filter((p) => p.categoriaSlug === producto.categoriaSlug && p.codigo !== producto.codigo)
  .sort((a, b) => Number(!!resolverImagenProducto(b.codigo)) - Number(!!resolverImagenProducto(a.codigo)))
  .slice(0, 6);

const payload = JSON.stringify({
  codigo: producto.codigo,
  nombre: producto.nombre,
  categoria: producto.categoria,
  escalas: producto.escalas,
});

const WHATSAPP_NUMBER = import.meta.env.PUBLIC_WHATSAPP_NUMBER || "";
const urlProducto = new URL(`/productos/${producto.codigo}/`, Astro.site).toString();
const mensajeConsulta = encodeURIComponent(
  `Hola! Quería consultar por este producto: ${producto.nombre} (Cód. ${producto.codigo}) ${urlProducto}`
);
const whatsappConsulta = WHATSAPP_NUMBER ? `https://wa.me/${WHATSAPP_NUMBER}?text=${mensajeConsulta}` : "#";

const descripcion = `${producto.nombre} — ${categoriaNombre}. ${
  precioDesde ? `Desde ${formatARS(precioDesde)} por ${unidad} según cantidad. ` : ""
}Pedilo por WhatsApp a Prodim.`;
---

<Layout title={`${producto.nombre} · Prodim`} description={descripcion} image={imagen ?? undefined}>
  <Header />
  <NavBar activo="catalogo" />

  <main class="mx-auto max-w-5xl px-4 py-6 sm:py-10">
    <nav aria-label="Ruta" class="mb-4 text-xs text-ink-600">
      <a href="/productos" class="focus-ring rounded hover:underline">Tienda</a>
      <span class="mx-1">›</span>
      <a href={`/productos?categoria=${producto.categoriaSlug}`} class="focus-ring rounded hover:underline">{categoriaNombre}</a>
    </nav>

    <!-- Misma estructura de datos que la card (clase product-card + data-product),
         así el carrito (src/scripts/cart.ts) funciona igual acá. -->
    <article
      class="product-card grid gap-6 rounded-lg border border-ink-100 bg-white p-4 font-comfortaa shadow-card sm:p-6 md:grid-cols-2 md:gap-10"
      data-codigo={producto.codigo}
      data-product={payload}
    >
      <div class="flex aspect-square items-center justify-center overflow-hidden rounded-lg bg-white">
        {imagen ? (
          <img src={imagen} alt={producto.nombre} width="800" height="800" class="h-full w-full rounded-2xl object-contain" />
        ) : (
          <img src="/images/sin-foto.webp" alt="" width="240" height="222" class="w-1/2 opacity-25" />
        )}
      </div>

      <div class="flex flex-col gap-4">
        <div>
          <p class="stencil-tag">COD. {producto.codigo} · {categoriaNombre}</p>
          <h1 class="mt-2 font-display text-xl font-bold leading-snug text-ink-900 sm:text-2xl">{producto.nombre}</h1>
          {producto.dilucion && (
            <p class="mt-2 text-sm font-semibold text-batch-700">Dilución: {producto.dilucion}</p>
          )}
        </div>

        <div class="flex flex-col gap-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-ink-600">Precio según cantidad</p>
          <CompraProducto producto={producto} grande />
        </div>

        <a
          href={whatsappConsulta}
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring flex items-center justify-center gap-2 rounded-md border border-ink-200 bg-white px-4 py-3 text-sm font-semibold text-ink-800 transition-colors hover:bg-ink-50"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.94 11.94 0 0 0 12.04 0C5.5 0 .2 5.3.2 11.85c0 2.09.55 4.13 1.6 5.93L0 24l6.4-1.68a11.86 11.86 0 0 0 5.64 1.44h.01c6.54 0 11.85-5.3 11.85-11.85 0-3.17-1.23-6.15-3.38-8.43ZM12.05 21.6a9.7 9.7 0 0 1-4.95-1.36l-.35-.21-3.7.97.99-3.6-.23-.37a9.75 9.75 0 1 1 8.24 4.57Zm5.34-7.3c-.29-.15-1.72-.85-1.99-.94-.27-.1-.46-.15-.66.14-.2.29-.76.94-.93 1.13-.17.2-.34.22-.63.07-.29-.15-1.23-.45-2.34-1.44-.87-.77-1.45-1.72-1.62-2.01-.17-.29-.02-.45.13-.6.13-.13.29-.34.44-.51.15-.17.2-.29.29-.48.1-.2.05-.37-.02-.51-.07-.15-.66-1.59-.9-2.17-.24-.57-.48-.5-.66-.5h-.56c-.2 0-.51.07-.78.37-.27.29-1.02 1-1.02 2.44s1.05 2.83 1.19 3.03c.15.2 2.06 3.15 5 4.42.7.3 1.24.48 1.67.62.7.22 1.34.19 1.84.12.56-.08 1.72-.7 1.96-1.38.24-.68.24-1.26.17-1.38-.07-.12-.26-.2-.55-.34Z"/></svg>
          Consultar por este producto
        </a>

        <p class="text-xs leading-relaxed text-ink-600">
          Los precios finales, la disponibilidad y la forma de pago se confirman por WhatsApp al cerrar el pedido.
        </p>
      </div>
    </article>

    {relacionados.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-4 font-display text-lg font-bold text-ink-900">Más de {categoriaNombre.toLowerCase()}</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
          {relacionados.map((p) => <ProductCard producto={p} />)}
        </div>
      </section>
    )}
  </main>

  <CartDrawer />

  <Footer />

  <script src="../../scripts/header-dropdown.ts"></script>
  <script src="../../scripts/mobile-search.ts"></script>
  <script src="../../scripts/cart.ts"></script>
</Layout>
